<Project Sdk="Microsoft.NET.Sdk">

  <!-- Debug probe: links the server's Audio/*.cs so it needs no reference to the web project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AudioProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\AudioPc.Server\Audio\*.cs" Exclude="..\..\AudioPc.Server\Audio\VolumeOsd.cs" LinkBase="Audio" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
